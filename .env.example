# Copy to .env for local development, or set these in your host's dashboard
# (on Vercel: Project → Settings → Environment Variables).
#
# Anything prefixed with VITE_ is bundled into the browser build, so secrets
# must never use that prefix.

# --- Inquiry email --------------------------------------------------------
# Without RESEND_API_KEY nothing is emailed: the inquiry is written to the
# server log instead, and the visitor still gets a confirmation.
RESEND_API_KEY=""
INQUIRY_TO_EMAIL="jonas.webstudio@gmail.com"
INQUIRY_FROM_EMAIL="Jonas Webstudio <hello@yourdomain.com>"

# --- Supabase (optional) --------------------------------------------------
# Keeps a copy of every inquiry in the contact_messages table.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLISHABLE_KEY=""

# --- Build target ---------------------------------------------------------
# Defaults to "vercel". Set to node-server, netlify, cloudflare-module, … to
# build for a different host.
# NITRO_PRESET="vercel"
